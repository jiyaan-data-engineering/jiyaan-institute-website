# Copy this file to ".env" and fill in your own values.
# ".env" is git-ignored, so your key never gets committed.

# Your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Any chat model you have access to, e.g. gpt-4o-mini, gpt-4o, gpt-4.1-mini
OPENAI_MODEL=gpt-4o-mini

# Enquiry emails (Gmail app password, not your normal Gmail password)
# https://myaccount.google.com/apppasswords
SMTP_USER=jiyaan.institute@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
ENQUIRY_TO=jiyaan.institute@gmail.com
